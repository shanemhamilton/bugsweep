{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugsweep/schemas/execution-receipt.schema.json",
  "title": "Bugsweep trusted execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invocation_id",
    "command",
    "command_sha256",
    "config_sha256",
    "environment_sha256",
    "cwd",
    "source_identity",
    "source_manifest_sha256",
    "execution_policy",
    "environment_allowlist",
    "declared_outputs",
    "backend",
    "backend_readback_path",
    "backend_readback_sha256",
    "backend_readback_verified",
    "mount_inventory_sha256",
    "applied_limits",
    "capabilities",
    "started_at",
    "finished_at",
    "exit_code",
    "termination",
    "reason",
    "outputs",
    "stdout_path",
    "stdout_sha256",
    "stderr_path",
    "stderr_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "invocation_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "string", "minLength": 1, "maxLength": 16384}
    },
    "command_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "environment_sha256": {"$ref": "#/$defs/sha256"},
    "cwd": {"type": "string", "minLength": 1, "maxLength": 4096},
    "source_identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sha256", "source_file_sha256"],
          "properties": {
            "kind": {"const": "content-manifest-sha256"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "source_file_sha256": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 100000,
              "propertyNames": {"type": "string", "minLength": 1, "maxLength": 4096},
              "additionalProperties": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sha256", "source_file_sha256"],
          "properties": {
            "kind": {"const": "unavailable"},
            "sha256": {"type": "null"},
            "source_file_sha256": {"type": "object", "maxProperties": 0}
          }
        }
      ]
    },
    "source_manifest_sha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "execution_policy": {
      "type": ["object", "null"],
      "maxProperties": 24
    },
    "environment_allowlist": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"},
      "additionalProperties": {"type": "string", "maxLength": 16384}
    },
    "declared_outputs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "max_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 4096},
          "kind": {"enum": ["junit", "sarif", "host-adapter-json"]},
          "max_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "engine_path", "engine_sha256", "image_digest", "container_id", "container_name"],
      "properties": {
        "name": {"enum": ["docker", "native", "unconfigured"]},
        "engine_path": {"type": ["string", "null"], "maxLength": 4096},
        "engine_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "image_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "container_id": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "container_name": {"type": ["string", "null"], "pattern": "^bugsweep-[0-9a-f]{32}$", "maxLength": 128}
      }
    },
    "backend_readback_path": {"type": ["string", "null"], "maxLength": 4096},
    "backend_readback_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "backend_readback_verified": {"type": "boolean"},
    "mount_inventory_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "applied_limits": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall_clock_seconds",
            "max_turns",
            "max_input_tokens",
            "max_output_tokens",
            "max_spend_usd",
            "enforcement",
            "enforced",
            "reason"
          ],
          "properties": {
            "wall_clock_seconds": {"type": "number", "exclusiveMinimum": 0},
            "max_turns": {"type": "number", "exclusiveMinimum": 0},
            "max_input_tokens": {"type": "number", "exclusiveMinimum": 0},
            "max_output_tokens": {"type": "number", "exclusiveMinimum": 0},
            "max_spend_usd": {"type": "number", "exclusiveMinimum": 0},
            "enforcement": {
              "type": "object",
              "minProperties": 5,
              "maxProperties": 5,
              "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 256}
            },
            "enforced": {"type": "boolean"},
            "reason": {"type": ["string", "null"], "maxLength": 256}
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isolation", "network", "deadline", "output_import", "evidence_tier"],
      "properties": {
        "isolation": {"enum": ["verified", "configured_unverified", "none", "unsupported"]},
        "network": {"enum": ["verified_denied", "approved_proxy_only_verified", "configured_denied_unverified", "configured_proxy_unverified", "host", "unsupported"]},
        "deadline": {"enum": ["process_group_term_kill_reap", "unsupported"]},
        "output_import": {"enum": ["trusted_side", "rejected", "not_run"]},
        "evidence_tier": {"enum": ["verified_backend", "host_execution", "configuration_only", "unverified"]}
      }
    },
    "started_at": {"$ref": "#/$defs/timestamp"},
    "finished_at": {"$ref": "#/$defs/timestamp"},
    "exit_code": {"type": ["integer", "null"]},
    "termination": {"enum": ["exited", "timeout", "cancelled", "backend_unavailable"]},
    "reason": {"type": ["string", "null"], "maxLength": 512},
    "outputs": {
      "type": "array",
      "maxItems": 35,
      "items": {"$ref": "#/$defs/output"}
    },
    "stdout_path": {"type": ["string", "null"], "maxLength": 4096},
    "stdout_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "stderr_path": {"type": ["string", "null"], "maxLength": 4096},
    "stderr_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "backendReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "analysis"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "docker-inspect-readback"},
        "analysis": {"type": "object"},
        "proxy": {"type": "object"},
        "networks": {"type": "array", "minItems": 2, "maxItems": 2}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "bytes"],
      "properties": {
        "kind": {"enum": ["stdout", "stderr", "backend-readback", "junit", "sarif", "host-adapter-json"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 16777216}
      }
    }
  }
}
