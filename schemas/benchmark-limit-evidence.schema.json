{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugsweep/schemas/benchmark-limit-evidence.schema.json",
  "title": "Bugsweep post-stop benchmark limit evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "owner",
    "run_id",
    "created_at",
    "execution_receipt_sha256",
    "proxy_receipt_sha256",
    "proxy_policy_sha256",
    "configured_limits",
    "source_evidence",
    "lifecycle",
    "usage",
    "live_cap_verified",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "benchmark-limit-evidence"
    },
    "owner": {
      "const": "bench/harness.py"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "execution_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "proxy_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "proxy_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "configured_limits": {
      "$ref": "#/$defs/limits"
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proxy_image_digest",
        "provider_proxy_sha256",
        "image_label_matches"
      ],
      "properties": {
        "proxy_image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provider_proxy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "image_label_matches": {
          "type": "boolean"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proxy_drained",
        "proxy_removed",
        "internal_network_removed",
        "egress_network_removed"
      ],
      "properties": {
        "proxy_drained": {
          "type": "boolean"
        },
        "proxy_removed": {
          "type": "boolean"
        },
        "internal_network_removed": {
          "type": "boolean"
        },
        "egress_network_removed": {
          "type": "boolean"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_log_path",
        "event_log_sha256",
        "event_count",
        "admitted_turns",
        "rejected_requests",
        "input_tokens",
        "output_tokens",
        "budget_charged_usd",
        "budget_overshoot_usd",
        "inflight_requests_at_stop",
        "accounting_complete"
      ],
      "properties": {
        "event_log_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "event_log_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "event_count": {
          "type": "integer",
          "minimum": 0
        },
        "admitted_turns": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_requests": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "budget_charged_usd": {
          "type": "number",
          "minimum": 0
        },
        "budget_overshoot_usd": {
          "type": "number",
          "minimum": 0
        },
        "inflight_requests_at_stop": {
          "type": "integer",
          "minimum": 0
        },
        "accounting_complete": {
          "type": "boolean"
        }
      }
    },
    "live_cap_verified": {
      "type": "boolean"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_clock_seconds",
        "max_turns",
        "max_input_tokens",
        "max_output_tokens",
        "max_spend_usd"
      ],
      "properties": {
        "wall_clock_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_turns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max_spend_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
