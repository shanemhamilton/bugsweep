{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bugsweep executable fix proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "bug_id", "command_sha256", "config_sha256", "environment_sha256", "execution_policy_mode", "source_manifest_sha256", "review_source_file_sha256", "review_source_manifest_sha256", "suite_receipt_path", "suite_receipt_sha256", "original_request_sha256", "post_revision_sha256", "test", "intended_source_files", "before", "after", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "bug_id": {"type": "string", "minLength": 1},
    "command_sha256": {"$ref": "#/$defs/hash"},
    "config_sha256": {"$ref": "#/$defs/hash"},
    "environment_sha256": {"$ref": "#/$defs/hash"},
    "execution_policy_mode": {"const": "required-untrusted"},
    "source_manifest_sha256": {"$ref": "#/$defs/hash"},
    "review_source_file_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "review_source_manifest_sha256": {"$ref": "#/$defs/hash"},
    "suite_receipt_path": {"type": "string", "minLength": 1},
    "suite_receipt_sha256": {"$ref": "#/$defs/hash"},
    "original_request_sha256": {"$ref": "#/$defs/hash"},
    "post_revision_sha256": {"$ref": "#/$defs/hash"},
    "test": {"$ref": "#/$defs/test"},
    "intended_source_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "before": {"$ref": "#/$defs/phase"},
    "after": {"$ref": "#/$defs/phase"},
    "status": {"enum": ["pending", "verified", "unreproduced", "proof_error", "failed"]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test": {"type": "object", "additionalProperties": false, "required": ["path", "native_id", "sha256", "expected_failure_type", "expected_failure_message"], "properties": {"path": {"type": "string", "minLength": 1}, "native_id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "expected_failure_type": {"const": "assertion"}, "expected_failure_message": {"type": "string", "minLength": 1}}},
    "phase": {"type": "object", "additionalProperties": false, "required": ["source_file_sha256", "exit_code", "test_outcome", "structured_report_path", "structured_report_sha256", "log_path", "log_sha256", "execution"], "properties": {"source_file_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}}, "exit_code": {"type": ["integer", "null"], "minimum": 0}, "test_outcome": {"type": "object", "additionalProperties": false, "required": ["native_id", "status", "failure_type", "message"], "properties": {"native_id": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "failure", "error", "skipped"]}, "failure_type": {"type": ["string", "null"]}, "message": {"type": ["string", "null"]}}}, "structured_report_path": {"type": "string", "minLength": 1}, "structured_report_sha256": {"$ref": "#/$defs/hash"}, "log_path": {"type": "string", "minLength": 1}, "log_sha256": {"$ref": "#/$defs/hash"}, "execution": {"type": "object"}}}
  }
}
