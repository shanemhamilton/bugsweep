{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bugsweep/bench/schemas/evaluation-invocation-receipt.schema.json",
  "title": "Bugsweep immutable evaluation invocation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "host", "model", "case_id", "repetition", "limit_profile", "arm", "stage_block", "ordinal", "schedule_slot_sha256", "order_slot_sha256", "schedule_sha256", "execution_order_sha256", "evaluation_mode", "effective_prompt_sha256", "effective_prompt_binding_sha256", "provenance", "configured_limits", "applied_limits", "source", "stage_lineage", "stage_receipts", "execution_receipt_sha256", "raw_response_sha256", "trusted_source_excerpts", "first_finding_wallclock_seconds", "lifecycle", "result", "reason_code", "usage", "accounting_state", "limit_evidence"],
  "properties": {
    "schema_version": {"const": 1}, "experiment_id": {"type": "string"}, "host": {"enum": ["claude", "codex"]}, "model": {"type": "string"}, "case_id": {"type": "string"}, "repetition": {"type": "integer", "minimum": 1}, "limit_profile": {"type": "string"}, "arm": {"enum": ["current_skill", "previous_release", "no_skill_baseline"]}, "stage_block": {"type": "string"}, "ordinal": {"type": "integer", "minimum": 1}, "schedule_slot_sha256": {"$ref": "#/$defs/sha256"}, "order_slot_sha256": {"$ref": "#/$defs/sha256"}, "schedule_sha256": {"$ref": "#/$defs/sha256"}, "execution_order_sha256": {"$ref": "#/$defs/sha256"}, "evaluation_mode": {"const": "reduced_detect_only_prompt_methodology"}, "effective_prompt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "effective_prompt_binding_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "provenance": {"type": "object", "required": ["model_version", "skill_revision", "skill_content_sha256", "skill_entrypoint_sha256", "adapter_sha256", "prompt_sha256", "config_sha256"]},
    "configured_limits": {"type": "object"}, "applied_limits": {"type": "object", "required": ["wall_clock_seconds", "enforced"]},
    "source": {"type": "object", "required": ["expected_manifest_sha256", "observed_pre_manifest_sha256", "observed_post_manifest_sha256", "valid"]},
    "stage_lineage": {"type": "object", "required": ["block_id", "stages", "stage_count", "role", "host", "model", "model_version", "source_manifest_sha256", "deadline_epoch", "configured_total_limits", "stage_prompt_template_sha256", "proxy"]}, "stage_receipts": {"type": "array", "items": {"type": "object", "required": ["stage", "role", "model", "source_manifest_sha256", "source_valid", "candidate_input_sha256", "stage_prompt_template_sha256", "prompt_sha256", "execution_receipt_sha256", "raw_response_path", "raw_response_sha256", "native_session_id", "lifecycle", "reason_code"]}},
    "execution_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "raw_response_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "trusted_source_excerpts": {"type": "array", "maxItems": 8, "items": {"type": "object", "required": ["path", "start_line", "end_line", "source_sha256", "text"]}}, "first_finding_wallclock_seconds": {"type": ["number", "null"], "minimum": 0},
    "lifecycle": {"enum": ["completed", "error", "skipped"]}, "result": {"type": "string"}, "reason_code": {"type": ["string", "null"]}, "usage": {"type": "object", "required": ["input_tokens", "output_tokens", "total_tokens", "cost_usd", "cost_source", "provider", "wall_clock_seconds"]}, "accounting_state": {"enum": ["complete", "unknown", "incomplete"]}, "limit_evidence": {"oneOf": [{"type": "object", "required": ["path", "sha256", "schema_version", "owner"]}, {"type": "null"}]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
