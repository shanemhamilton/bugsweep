# The pinned Python base is supplied by the operator.  The stdlib-only proxy is
# the sole process that reads /run/secrets/provider-key and injects it upstream.
ARG BENCH_PROXY_BASE_IMAGE
FROM ${BENCH_PROXY_BASE_IMAGE}

ARG PROXY_SOURCE_SHA256
LABEL org.bugsweep.proxy.source.sha256=${PROXY_SOURCE_SHA256}

USER root
COPY provider_proxy.py /usr/local/lib/bugsweep/provider_proxy.py
COPY provider_proxy_entrypoint.sh /usr/local/bin/bugsweep-provider-proxy
RUN test -n "${PROXY_SOURCE_SHA256}" \
 && test "$(sha256sum /usr/local/lib/bugsweep/provider_proxy.py | awk '{print $1}')" = "${PROXY_SOURCE_SHA256}" \
 && chmod 0555 /usr/local/bin/bugsweep-provider-proxy /usr/local/lib/bugsweep/provider_proxy.py
USER 65534:65534
WORKDIR /
EXPOSE 8888
ENTRYPOINT ["/usr/local/bin/bugsweep-provider-proxy"]
